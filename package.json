{
  "name": "opolo-shop-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run opolo:dev",
    "build": "concurrently \"npm run lint\" \"npm run opolo:build:dev\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tests": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "eslint src --ext .ts",
    "lint:fix": "npm run lint -- --fix",
    "compodoc": "npx compodoc -p tsconfig.doc.json",
    "concat:mock": "node \"./json-server/config/concat-json.js\"",
    "install:local": "npm install ../../../lib/msal-angular ../../../lib/msal-browser",
    "jsonServer": "npm run concat:mock && json-server json-server/db.json --routes json-server/config/routes.json --port 3000",
    "opolo:dev": "concurrently --kill-others \"npm run jsonServer\" \"ng serve --configuration=dev\"",
    "opolo:prod": "ng serve --configuration production",
    "opolo:build:dev": "ng build --configuration dev",
    "opolo:build:prod": "ng build --configuration production"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@ngrx/effects": "^17.2.0",
    "@ngrx/entity": "^17.2.0",
    "@ngrx/router-store": "^17.2.0",
    "@ngrx/store": "^17.2.0",
    "@ngrx/store-devtools": "^18.0.2",
    "concurrently": "^9.0.1",
    "json-concat": "^0.0.1",
    "json-server": "^0.17.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10",
    "primeflex":"3.1.2",
    "primeicons": "6.0.1",
    "primeng":"15.4.1",
    "uuid":"^9.0.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.10",
    "@angular/cli": "~17.3.10",
    "@angular/compiler-cli": "^17.3.12",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~5.4.5"
  }
}
